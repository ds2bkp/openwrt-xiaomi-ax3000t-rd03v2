ecm: map IPv4 multicast VLAN tags to the DSA conduit

Use bridge/standalone tag_8021q VIDs, compact duplicate switch outputs,
and reconstruct DSA flows on membership changes. Unknown VLAN-aware
bridge mappings remain in software.

--- a/frontends/nss/ecm_nss_multicast_ipv4.c
+++ b/frontends/nss/ecm_nss_multicast_ipv4.c
@@ -362,6 +362,46 @@
 	 */
 	ecm_front_end_connection_deref(feci);
 	ecm_db_connection_deref(ci);
+}
+
+/*
+ * Multicast rules use the same tag_8021q conduit as unicast. A VLAN-aware
+ * DSA bridge without an explicit VLAN hierarchy is ambiguous: keep it
+ * in software instead of guessing its PVID.
+ */
+static int ecm_nss_multicast_ipv4_dsa_tag(struct ecm_db_iface_instance *ii,
+				       uint32_t tag[2])
+{
+	struct net_device *dev;
+	uint16_t vid;
+
+	dev = dev_get_by_index(&init_net, ecm_db_iface_interface_identifier_get(ii));
+	if (!dev)
+		return -ENODEV;
+	rcu_read_lock();
+	vid = ecm_nss_common_dsa_8021q_vid_get(dev);
+#if IS_ENABLED(CONFIG_NET_DSA)
+	if (dsa_user_dev_check(dev)) {
+		struct dsa_port *dp = dsa_port_from_netdev(dev);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		if (dp->ds->tag_8021q_ctx && br && br_vlan_enabled(br) &&
+		    tag[0] == ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED) {
+			rcu_read_unlock();
+			dev_put(dev);
+			return -EOPNOTSUPP;
+		}
+	}
+#endif
+	rcu_read_unlock();
+	dev_put(dev);
+	if (!vid)
+		return 0;
+	if (tag[0] != ECM_FRONT_END_VLAN_ID_NOT_CONFIGURED &&
+	    tag[0] != ((ETH_P_8021Q << 16) | vid))
+		return -EOPNOTSUPP;
+	tag[0] = (ETH_P_8021Q << 16) | vid;
+	return 1;
 }
 
