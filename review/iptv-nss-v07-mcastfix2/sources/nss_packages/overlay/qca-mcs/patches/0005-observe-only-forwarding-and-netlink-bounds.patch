@@ -475,6 +488,37 @@
 	fdb = os_br_fdb_get(br, eth_hdr(skb)->h_source);
 	if (!fdb)
 		return -EINVAL;
+
+	if (observe_only) {
+		struct sk_buff *copy;
+		struct iphdr ipbuf, *ip;
+		struct ipv6hdr ip6buf, *ip6;
+		__be16 proto = eth_hdr(skb)->h_proto;
+
+		/* Do not allocate/copy IPTV UDP packets on the data path. */
+		if (proto == htons(ETH_P_IP)) {
+			ip = skb_header_pointer(skb, skb_network_offset(skb), sizeof(ipbuf), &ipbuf);
+			if (!ip || ip->protocol != IPPROTO_IGMP)
+				return -EINVAL;
+		} else if (proto == htons(ETH_P_IPV6)) {
+			ip6 = skb_header_pointer(skb, skb_network_offset(skb), sizeof(ip6buf), &ip6buf);
+			if (!ip6 || (ip6->nexthdr != IPPROTO_HOPOPTS &&
+				     ip6->nexthdr != IPPROTO_ICMPV6))
+				return -EINVAL;
+		} else {
+			return -EINVAL;
+		}
+		copy = skb_copy(skb, GFP_ATOMIC);
+		if (copy) {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 0))
+			mc_rcv(mc, copy, fdb->key.addr.addr, src->dev);
+#else
+			mc_rcv(mc, copy, fdb->addr.addr, src->dev);
+#endif
+			kfree_skb(copy);
+		}
+		return -EINVAL;
+	}
 
