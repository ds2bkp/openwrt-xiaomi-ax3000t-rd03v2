@@ -31,6 +34,14 @@
 
 int mc_forward_init(void) __maybe_unused;
 void mc_forward_exit(void) __maybe_unused;
+
+/*
+ * Observe IGMP/MLD for ECM but leave forwarding to the Linux bridge.
+ * An empty/unavailable offload table must never interrupt IPTV.
+ */
+static bool observe_only = true;
+module_param(observe_only, bool, 0444);
+MODULE_PARM_DESC(observe_only, "Snoop control traffic without consuming multicast packets");
 
 static void mc_retag(void *iph, __be16 etype, __be32 dscp)
 {
